# AutoAdmit Engine Configuration

# System Security & Gate Controls
SYSTEM_GATE_ACTIVE=true
SANDBOX_MODE=true
TEST_RECIPIENT_EMAIL=applicant.test@example.com
BASIC_AUTH_USERNAME=admin
BASIC_AUTH_PASSWORD=2026

# Persistence & Storage Mounts (P12 reads MONGO_URI or MONGODB_URI)
MONGO_URI=mongodb://admin:your_password@127.0.0.1:27017/?authSource=admin&replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://localhost:27017
DB_NAME=autoadmit_p12
DB_STORAGE_PATH=./data/db
LOG_DIR=./data/logs

# P12 Multi-Key OpenAI-Compatible LLM Router (Primary Gemini -> Backup Free Key)
PRIMARY_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
PRIMARY_LLM_API_KEY=
PRIMARY_LLM_MODEL=gemini-2.0-flash-lite

BACKUP_LLM_BASE_URL=https://coarena.ai/api/v1
BACKUP_LLM_API_KEY=
BACKUP_LLM_MODEL=gemini-3-8-flash

# P12 Search-First Provider (Strategy A)
SERPER_API_KEY=

# P12 Optional Google Colab T4 GPU Model Bridge (/score-links, /html-to-md)
COLAB_BASE_URL=
COLAB_API_KEY=

# Legacy Google Gemini Intelligence Agent (src/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Outbound SMTP Engine (China Standard Time Dispatch)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_NAME="Applicant Name"
SENDER_EMAIL=

# CST Smart Scheduling & Rate Limiting
CST_SEND_START_HOUR=9
CST_SEND_END_HOUR=16
MAX_EMAILS_PER_HOUR=10
MAX_EMAILS_PER_DAY=25
JITTER_MIN_SECONDS=90
JITTER_MAX_SECONDS=240

# Inbound IMAP Response Poller
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USERNAME=applicant@example.com
IMAP_PASSWORD=your_app_password
IMAP_POLL_INTERVAL_MINUTES=15

# Tracking Service Base URL (Public Cloudflare Tunnel URL or Localhost)
TRACKING_BASE_URL=http://localhost:8000

